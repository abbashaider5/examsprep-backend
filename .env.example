NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Production frontend URL (required for CORS + auth cookies when API is on a different host)
# CLIENT_URL=https://likhitai.com
# Extra allowed origins (comma-separated), e.g. Vercel preview URLs or staging domains
# CORS_ORIGINS=https://staging.likhitai.com,https://my-app.vercel.app
# Where the app is reachable over HTTPS (used for logo + links inside emails). Required when CLIENT_URL is localhost — Gmail cannot load http://localhost images.
# EMAIL_PUBLIC_URL=https://likhitai.com

# Mongo
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
# Optional dev fallback
MONGODB_URI_FALLBACK=mongodb://127.0.0.1:27017/examprep

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change_me_cookie

# Google login (ID token verification)
GOOGLE_CLIENT_ID=95894739982-q63678qsi1ljh6o60h6ab5djo5uv3qql.apps.googleusercontent.com

# reCAPTCHA (Login + Signup)
RECAPTCHA_SECRET_KEY=6Ldw7NUsAAAAAEajKMplytq8qh2gMMIqDsvfCyCU

# AI (Groq)
GROQ_API_KEY=your_key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — resource RAG embeddings (server-side only; never expose in client)
# text-embedding-004 outputs 768-dimensional vectors by default — Atlas index must match.
GEMINI_API_KEY=AIzaSyDIiuFG3ITFMNO7h2sVMvRxQKeTuRCcF40
GEMINI_EMBEDDING_MODEL=text-embedding-004
# GEMINI_EMBEDDING_TIMEOUT_MS=90000
# EMBEDDING_SERVICE_DISABLED=true

# MongoDB Atlas Vector Search — vector dimension must match GEMINI model (768 for text-embedding-004 default).
# If migrating from another model (e.g. 384 local or 1536 OpenAI), recreate the vector index to avoid retrieval errors.
# MONGODB_VECTOR_INDEX_NAME=resource_chunks_vector
# MONGODB_VECTOR_INDEX_PATH=embedding

# Email (Resend) — EMAIL_FROM must use a domain you verified in Resend (DNS).
RESEND_API_KEY=your_key
EMAIL_FROM=LikhitAI <no-reply@your-verified-domain.com>
# Optional full URL to logo PNG (overrides {EMAIL_PUBLIC_URL or CLIENT_URL}/likhitai-white-logo.png).
# EMAIL_LOGO_URL=https://likhitai.com/likhitai-white-logo.png

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# Cloudinary (optional)
# CLOUDINARY_CLOUD_NAME=xxx
# CLOUDINARY_API_KEY=xxx
# CLOUDINARY_API_SECRET=xxx

# PDF → DOCX recovery (optional). Weak PDFs are converted then processed with the same Mammoth/RAG path as native DOCX.
PDF_CONVERSION_PROVIDER=none
PDF_CONVERSION_PROVIDER=cloudconvert
CLOUDCONVERT_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..QKbnJYgrtXrLaQC5dBJv9kWw4lwCzzKrtKnBE_3IDemjphHWNd2ZA5QHM5Vj1xj93ReEtM_uwd4AqTMa2d_EAcsyCdGHzJYJbxXJ44ABPf-EqAUelEtm9HdPhGFb5jdObEh4an0i1MnM2ASKzCEjIn9dz1GkYTDJdecRRDE5i2Fqz_hU8kFaTqGyoYokJyGA8O0O5gn_SbeG1cVxlZITkUgaoYo_BxW2HmnXCPxlq2nJkmZvWHGYCOZPfkamzgEa9B_sX1ijvc5s_axRsol1YLE3Mt_yASNFkMFgNkJfYdwVdAR8jQ2BjPfAfI-mJmQwNMbjZN-XCy2pyGd7XO2f-8EvAGGgJ5gEc2KWSarvisjXvFKzIDpNKcb7YIySLaX_yf5YSCQ81NVKS39oOlVUmOgaeSG4U5IC5HdghbXAl6vG3bhRAh70q9UEnRrbsgOBO5xgskCGnqg0R-9vIJ6auOobqgREvNTZoD6q_ibC6O0Kr6CvX2b0N1xxd4Gt7MkLyU0iMHi6Finffw5IwPGylx7L8fsH1lBGTAPZ48Bzk-NlinIKJpEP7O6g3qijtpx1UO80R6hqthkSLxddK1kwLeSTWFnpaGwNeRov_Zw8XwG2HY21ppoToTxRdnAg5pJFVDRGxgKm9yukJhgfal1Duh_-5dXk5mRPopnIZxLVIME
